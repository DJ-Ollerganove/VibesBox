    function partyPreWishSettingsPatchValuesSafe(partyId) {
      let changed = request.resource.data.diff(resource.data).changedKeys();
      let prev = resource.data;
      let next = request.resource.data;
      return (!changed.hasAny(['allow_pre_wishes']) || (
          next.allow_pre_wishes is bool
          && !(prev.allow_pre_wishes == true && next.allow_pre_wishes == false)
          && (
            next.allow_pre_wishes == prev.allow_pre_wishes
            || (
              prev.allow_pre_wishes != true
              && next.allow_pre_wishes == true
              && isWithinPreWishWindow(partyId)
            )
          )
        ))
        && (!changed.hasAny(['pre_wish_limit_per_guest']) || (
          (next.pre_wish_limit_per_guest is int || next.pre_wish_limit_per_guest is float)
          && next.pre_wish_limit_per_guest >= 0
          && next.pre_wish_limit_per_guest <= 50
          && isWithinPreWishWindow(partyId)
        ));
    }

