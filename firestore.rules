rules_version = '2';
// vibesbox-rules-deploy-bump 2026-09-23-sync-installs
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Pfad-Helfer (einheitliche Referenzen; wiederholte get() auf denselben Pfad zählen als eine Operation) ---
    function usersDocPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }
    function partiesDocPath(partyId) {
      return /databases/$(database)/documents/parties/$(partyId);
    }
    function musicHistoryDocPath(sessionId) {
      return /databases/$(database)/documents/music_history/$(sessionId);
    }

    // --- Party: Typ-/Pflichtfeld zuerst, dann exists/get (invalid Requests ohne Doc-Read ablehnen) ---
    function partyIdWellFormed(partyId) {
      return partyId is string && partyId.size() > 0;
    }
    function partyDocExists(partyId) {
      return partyIdWellFormed(partyId) && exists(partiesDocPath(partyId));
    }
    /** Ein get() auf parties/{partyId}; nur nach partyDocExists oder gleichwertiger Absicherung aufrufen. */
    function partyData(partyId) {
      return get(partiesDocPath(partyId)).data;
    }
    function partyLifecycleIsActive(partyId) {
      return partyDocExists(partyId)
        && (
          !('lifecycle_status' in partyData(partyId))
          || partyData(partyId).lifecycle_status == null
          || partyData(partyId).lifecycle_status == 'active'
        );
    }

    /** Vorab-Wünsche: Party noch nicht beendet, auch standby/upcoming (Test-/Zukunfts-Partys). */
    function partyLifecycleAllowsPreWish(partyId) {
      return partyDocExists(partyId)
        && (
          !('lifecycle_status' in partyData(partyId))
          || partyData(partyId).lifecycle_status == null
          || partyData(partyId).lifecycle_status in ['active', 'standby', 'upcoming']
        );
    }
    function partyWishboxOpenOrMissing(partyId) {
      return !('wishbox_enabled' in partyData(partyId))
        || partyData(partyId).wishbox_enabled == true;
    }

    // --- Auth-User-Dokument: nach request.auth != null nutzen ---
    function authUserDocExists() {
      return request.auth != null && exists(usersDocPath(request.auth.uid));
    }
    function authUserData() {
      return get(usersDocPath(request.auth.uid)).data;
    }

    /** DJ-VibesBox im Browser — Custom-Token mit role dj_browser. */
    function djBrowserSessionDocPath(sessionId) {
      return /databases/$(database)/documents/dj_browser_sessions/$(sessionId);
    }
    function isDjBrowserSession(partyId) {
      return request.auth != null
        && request.auth.token.role == 'dj_browser'
        && request.auth.token.partyId == partyId
        && request.auth.token.sessionId is string
        && request.auth.token.sessionId.size() > 0
        && exists(djBrowserSessionDocPath(request.auth.token.sessionId))
        && get(djBrowserSessionDocPath(request.auth.token.sessionId)).data.active == true
        && get(djBrowserSessionDocPath(request.auth.token.sessionId)).data.partyId == partyId;
    }

    /** Party-Besitzer-UID (Legacy-Felder wie in assertPartyOwner). */
    function partyOwnerUidMatches(partyId, uid) {
      let p = partyData(partyId);
      return uid is string
        && uid.size() > 0
        && (
          ('created_by' in p && p.created_by == uid)
          || ('djId' in p && p.djId == uid)
          || ('uid' in p && p.uid == uid)
          || ('dj_code' in p && p.dj_code == uid)
        );
    }

    /** DJ-Browser: manueller Offen-Wunsch (wie Flutter ManualWishPage, is_dj_wish). */
    function isDjBrowserManualWishCreate(data, partyId) {
      return isDjBrowserSession(partyId)
        && partyDocExists(partyId)
        && data.status == 'pending'
        && data.is_dj_wish == true
        && (!('is_pre_wish' in data) || data.is_pre_wish != true)
        && data.party_id == partyId
        && ('dj_id' in data)
        && data.dj_id is string
        && ('djId' in data)
        && data.djId is string
        && data.dj_id == data.djId
        && (
          partyOwnerUidMatches(partyId, data.dj_id)
          || (
            request.auth.token.ownerUid is string
            && request.auth.token.ownerUid.size() > 0
            && data.dj_id == request.auth.token.ownerUid
          )
        )
        && data.duplicate_count == 0
        && data.is_duplicate == false;
    }

    // Zentrale XSS/Payload-Pruefung fuer Texteingaben.
    function isSafeText(text, maxLen) {
      return text is string
        && text.size() <= maxLen
        && !text.matches('.*<[sS][cC][rR][iI][pP][tT].*')
        && !text.matches('.*[jJ][aA][vV][aA][sS][cC][rR][iI][pP][tT][[:space:]]*:.*')
        && !text.matches('.*<[iI][fF][rR][aA][mM][eE].*');
    }

    function isSafeOptionalText(data, field, maxLen) {
      return !(field in data) || data[field] == null || isSafeText(data[field], maxLen);
    }

    /** party_code / fixed_party_code: Legacy-Docs nutzen teils int statt string. */
    function isSafePartyCodeField(data, field, maxLen) {
      return !(field in data)
        || data[field] == null
        || (data[field] is string && isSafeText(data[field], maxLen))
        || (data[field] is int && data[field] > 0)
        || (data[field] is float && data[field] > 0);
    }

    function isSafeUserData(data) {
      return isSafeOptionalText(data, 'displayName', 50)
        && isSafeOptionalText(data, 'realName', 80)
        && isSafeOptionalText(data, 'phoneNumber', 40)
        && isSafeOptionalText(data, 'email', 100)
        && isSafeOptionalText(data, 'pendingEmail', 100)
        && isSafeOptionalText(data, 'status', 40)
        && isSafeOptionalText(data, 'country', 80)
        && isSafeOptionalText(data, 'alternativeEmail', 100)
        && (!('useAlternativeEmail' in data) || data.useAlternativeEmail is bool)
        && isSafeOptionalText(data, 'language', 12)
        && isSafeOptionalText(data, 'selected_language', 12)
        && isSafeOptionalText(data, 'fcm_token_platform', 20)
        && (!('fcm_token_updated_at' in data)
          || data.fcm_token_updated_at == null
          || data.fcm_token_updated_at is timestamp)
        && (!('emailChangeRequestedAt' in data)
          || data.emailChangeRequestedAt == null
          || data.emailChangeRequestedAt is timestamp)
        && (!('email_history' in data)
          || (data.email_history is list && data.email_history.size() <= 50))
        && (!('dj_notif_awaiting_first_device_seed' in data)
          || data.dj_notif_awaiting_first_device_seed is bool)
        && isSafeOptionalText(data, 'djLogoUrl', 2048)
        && isSafeOptionalText(data, 'dj_logo_url', 2048)
        && isSafeOptionalText(data, 'photoURL', 2048)
        && isSafeOptionalText(data, 'planType', 40)
        && isSafeOptionalText(data, 'role_id', 60)
        && isSafeOptionalText(data, 'fcm_token', 4096)
        && isSafeOptionalText(data, 'last_app_system_locale_tag', 80)
        && (!('emailVerified' in data) || data.emailVerified is bool)
        && (!('email_verified' in data) || data.email_verified is bool)
        && (!('wishbox_suggestions_enabled' in data) || data.wishbox_suggestions_enabled is bool)
        && (!('show_greeting_translations' in data) || data.show_greeting_translations is bool)
        && (!('notifyNewWishes' in data) || data.notifyNewWishes is bool)
        && (!('enableNotificationSound' in data) || data.enableNotificationSound is bool)
        && (!('show_status_notification' in data) || data.show_status_notification is bool)
        && (!('vibesbox_sync_enabled' in data) || data.vibesbox_sync_enabled is bool)
        && (!('hasCompletedProfile' in data) || data.hasCompletedProfile is bool)
        && (!('hasSeenQuickstart' in data) || data.hasSeenQuickstart is bool)
        && (!('birthDate' in data) || data.birthDate == null || data.birthDate is timestamp)
        && (!('grace_period_minutes' in data)
          || (data.grace_period_minutes is number
            && data.grace_period_minutes >= 0
            && data.grace_period_minutes <= 120))
        && (!('song_rec_enabled' in data) || data.song_rec_enabled is bool)
        && (!('song_rec_same_artist' in data) || data.song_rec_same_artist is bool)
        && (!('song_rec_count' in data) || isSafeSongRecCountValue(data.song_rec_count))
        && isSafeOptionalSongRecScope(data)
        && isSafeOptionalSongRecTempo(data)
        && isSafeOptionalSongRecFamiliarity(data);
    }

    function isSafeGuestLiveWishboxData(data) {
      return data != null
        && data.keys().hasOnly([
          'wishbox_suggestions_enabled',
          'updatedAt',
        ])
        && data.wishbox_suggestions_enabled is bool
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isSafeUserRegistrationPayload(data) {
      return isSafeUserData(data)
        && userRegistrationForbidsPrivileges(data)
        && (!('loginCount' in data)
          || (data.loginCount is int && data.loginCount >= 0 && data.loginCount < 100000000))
        && (!('guestWishesSubmittedCount' in data)
          || (data.guestWishesSubmittedCount is int
            && data.guestWishesSubmittedCount >= 0
            && data.guestWishesSubmittedCount < 100000000))
        && (!('lastLogin' in data) || data.lastLogin is timestamp)
        && (!('created_at' in data) || data.created_at is timestamp);
    }

    /// Registrierung darf Gast/DJ setzen, nie Admin/Abo/Sperre.
    function roleDocNameIsAdmin(roleId) {
      return roleId is string
        && roleId.size() > 0
        && exists(/databases/$(database)/documents/roles/$(roleId))
        && get(/databases/$(database)/documents/roles/$(roleId)).data.name == 'Admin';
    }

    function userRegistrationForbidsPrivileges(data) {
      return (!('admin' in data) || data.admin != true)
        && (!('isPro' in data) || data.isPro != true)
        && (!('is_blocked' in data) || data.is_blocked != true)
        && (!('email_verified_override' in data) || data.email_verified_override != true)
        && (!('role_id' in data) || !roleDocNameIsAdmin(data.role_id));
    }

    /// Owner-Updates: Rolle/Abo/Admin unverändert (Admin-Pfad bleibt separat).
    function userOwnerCannotEscalatePrivileges() {
      return !request.resource.data.diff(resource.data).changedKeys().hasAny([
        'admin',
        'role_id',
        'isPro',
        'proUntil',
        'planType',
        'is_blocked',
        'email_verified_override'
      ]);
    }

    function userPreservesDeviceBlockFusion() {
      let changed = request.resource.data.diff(resource.data).changedKeys();
      return !resource.exists
        || !('device_block_fusion' in resource.data)
        || resource.data.device_block_fusion != true
        || !changed.hasAny(['device_block_fusion', 'is_blocked', 'status'])
        || (
          request.resource.data.device_block_fusion == true
          && request.resource.data.is_blocked == true
          && (
            request.resource.data.status == 'gesperrt'
            || request.resource.data.status == 'blocked'
          )
        );
    }

    /** DJ-B2B-Ledger und Referral-Verknüpfung nur via Cloud Functions. */
    function userPreservesDjB2bLedger() {
      return isAdmin()
        || !request.resource.data.diff(resource.data).changedKeys().hasAny([
          'djB2bCode',
          'djB2bDaysLifetimeEarned',
          'djB2bDaysPendingHold',
          'djB2bDaysAvailable',
          'djB2bDaysConsumptionActive',
          'djB2bDaysLastConsumedDate',
          'djB2bReferralCount',
          'referredByUid',
          'referredByCode',
          'referralCapturedAt',
          'referralRedeemedAt',
          'referralSource',
          'trialDaysGranted',
          'trialUsedDjB2bCode',
        ]);
    }

    function clientCannotSeedDjB2bFields(data) {
      return !('djB2bCode' in data)
        && !('djB2bDaysLifetimeEarned' in data)
        && !('djB2bDaysPendingHold' in data)
        && !('djB2bDaysAvailable' in data)
        && !('djB2bDaysConsumptionActive' in data)
        && !('djB2bDaysLastConsumedDate' in data)
        && !('djB2bReferralCount' in data)
        && !('referredByUid' in data)
        && !('referredByCode' in data)
        && !('referralCapturedAt' in data)
        && !('referralRedeemedAt' in data)
        && !('referralSource' in data)
        && !('trialDaysGranted' in data)
        && !('trialUsedDjB2bCode' in data);
    }

    function isSafeSocialLinksData(data) {
      return isSafeOptionalText(data, 'website', 300)
        && isSafeOptionalText(data, 'instagram', 300)
        && isSafeOptionalText(data, 'facebook', 300)
        && isSafeOptionalText(data, 'tiktok', 300)
        && isSafeOptionalText(data, 'youtube', 300)
        && isSafeOptionalText(data, 'spotify', 300)
        && isSafeOptionalText(data, 'soundcloud', 300)
        && isSafeOptionalText(data, 'whatsapp', 300);
    }

    function isSafeContactInfoData(data) {
      return isSafeOptionalText(data, 'name', 50)
        && isSafeOptionalText(data, 'displayName', 50)
        && isSafeOptionalText(data, 'email', 100)
        && isSafeOptionalText(data, 'phone', 40)
        && isSafeOptionalText(data, 'phoneNumber', 40)
        && isSafeOptionalText(data, 'message', 1500);
    }

    function isSafeHistoryData(data) {
      return isSafeOptionalText(data, 'description', 500)
        && isSafeOptionalText(data, 'type', 80)
        && isSafeOptionalText(data, 'source', 80)
        && isSafeOptionalText(data, 'status', 40)
        && isSafeOptionalText(data, 'old_email', 100)
        && isSafeOptionalText(data, 'new_email', 100)
        && isSafeOptionalText(data, 'request_id', 120);
    }

    function isSafeSavedTrackData(data) {
      return data != null
        && data.keys().hasOnly([
          'title',
          'artist',
          'party_id',
          'source_wish_id',
          'bookmarked_at',
        ])
        && isSafeText(data.title, 300)
        && isSafeText(data.artist, 300)
        && isSafeOptionalText(data, 'party_id', 120)
        && isSafeOptionalText(data, 'source_wish_id', 120)
        && data.bookmarked_at is timestamp;
    }

    function isSafeGracePeriodMinutesValue(v) {
      return v is number
        && v >= 0
        && v <= 120
        && v % 10 == 0;
    }

    function isSafeSongRecScopeValue(v) {
      return v is string && (v == 'strict' || v == 'similar' || v == 'bold');
    }

    function isSafeSongRecTempoValue(v) {
      return v is string && (
        v == 'exact'
        || v == 'bpm10'
        || v == 'bpm20'
        || v == 'bpm30'
        || v == 'bpm40'
        || v == 'over40'
      );
    }

    function isSafeSongRecFamiliarityValue(v) {
      return v is string && (v == 'hits' || v == 'mix');
    }

    function isSafeSongRecCountValue(v) {
      return v is int && v >= 1 && v <= 20;
    }

    function isSafeOptionalSongRecScope(data) {
      return !('song_rec_scope' in data) || isSafeSongRecScopeValue(data.song_rec_scope);
    }

    function isSafeOptionalSongRecTempo(data) {
      return !('song_rec_tempo' in data) || isSafeSongRecTempoValue(data.song_rec_tempo);
    }

    function isSafeOptionalSongRecFamiliarity(data) {
      return !('song_rec_familiarity' in data)
        || isSafeSongRecFamiliarityValue(data.song_rec_familiarity);
    }

    function isSafeDjAudioSettingsFields(data) {
      return (!('mic_sensitivity' in data)
          || (data.mic_sensitivity is number
            && data.mic_sensitivity >= 0.5
            && data.mic_sensitivity <= 2.0))
        && (!('recognition_threshold' in data)
          || (data.recognition_threshold is number
            && data.recognition_threshold >= 0
            && data.recognition_threshold <= 1))
        && (!('smart_threshold_enabled' in data)
          || data.smart_threshold_enabled is bool)
        && (!('auto_start_recognition' in data)
          || data.auto_start_recognition is bool)
        && (!('vibesbox_sync_enabled' in data)
          || data.vibesbox_sync_enabled is bool)
        && (!('shazam_scan_interval_seconds' in data)
          || (data.shazam_scan_interval_seconds is number
            && data.shazam_scan_interval_seconds >= 15
            && data.shazam_scan_interval_seconds <= 300));
    }

    function isSafeUserDevicesMap(devices) {
      return devices is map && devices.size() <= 32;
    }

    /** Nur geänderte Selbstbedienungs-Felder — kein Full-Doc-isSafeUserData für Legacy-Daten. */
    function userSelfServiceChangedKeysAllowed() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'displayName',
        'realName',
        'phoneNumber',
        'email',
        'pendingEmail',
        'country',
        'alternativeEmail',
        'useAlternativeEmail',
        'language',
        'selected_language',
        'emailChangeRequestedAt',
        'email_history',
        'fcm_token_platform',
        'fcm_token_updated_at',
        'dj_notif_awaiting_first_device_seed',
        'djLogoUrl',
        'dj_logo_url',
        'fcm_token',
        'last_app_system_locale_tag',
        'emailVerified',
        'email_verified',
        'wishbox_suggestions_enabled',
        'grace_period_minutes',
        'show_greeting_translations',
        'mic_sensitivity',
        'recognition_threshold',
        'smart_threshold_enabled',
        'auto_start_recognition',
        'vibesbox_sync_enabled',
        'shazam_scan_interval_seconds',
        'notifyNewWishes',
        'enableNotificationSound',
        'show_status_notification',
        'hasCompletedProfile',
        'hasSeenQuickstart',
        'read_announcements',
        'photoURL',
        'birthDate',
        'showLocationOnPdf',
        'showPhoneOnPdf',
        'showEmailOnPdf',
        'showAltEmailOnPdf',
        'song_rec_enabled',
        'song_rec_scope',
        'song_rec_tempo',
        'song_rec_familiarity',
        'song_rec_same_artist',
        'song_rec_count',
        'status',
        'app_version',
        'platform',
        'device_model',
        'device_model_code',
        'os_version',
        'app_version_updated_at',
        'last_seen',
        'devices',
        'loginCount',
        'lastLogin',
        'previousLogin',
        'created_at',
      ]);
    }

    function userSelfServiceChangedValuesSafe() {
      let data = request.resource.data;
      let changed = request.resource.data.diff(resource.data).changedKeys();
      return (!changed.hasAny(['devices'])
          || isSafeUserDevicesMap(data.devices))
        && (!changed.hasAny(['loginCount'])
          || (data.loginCount is int
            && data.loginCount >= 0
            && data.loginCount < 100000000))
        && (!changed.hasAny(['lastLogin'])
          || data.lastLogin is timestamp)
        && (!changed.hasAny(['previousLogin'])
          || data.previousLogin == null
          || data.previousLogin is timestamp)
        && (!changed.hasAny(['created_at'])
          || data.created_at is timestamp)
        && (!changed.hasAny(['app_version'])
          || isSafeOptionalText(data, 'app_version', 40))
        && (!changed.hasAny(['platform'])
          || (data.platform is string
            && (data.platform == 'ios' || data.platform == 'android')))
        && (!changed.hasAny(['device_model'])
          || isSafeOptionalText(data, 'device_model', 120))
        && (!changed.hasAny(['device_model_code'])
          || isSafeOptionalText(data, 'device_model_code', 40))
        && (!changed.hasAny(['os_version'])
          || isSafeOptionalText(data, 'os_version', 40))
        && (!changed.hasAny(['app_version_updated_at'])
          || data.app_version_updated_at is timestamp)
        && (!changed.hasAny(['last_seen'])
          || data.last_seen is timestamp)
        && (!changed.hasAny(['grace_period_minutes'])
          || isSafeGracePeriodMinutesValue(data.grace_period_minutes))
        && (!changed.hasAny(['smart_threshold_enabled'])
          || data.smart_threshold_enabled is bool)
        && (!changed.hasAny(['auto_start_recognition'])
          || data.auto_start_recognition is bool)
        && (!changed.hasAny(['vibesbox_sync_enabled'])
          || data.vibesbox_sync_enabled is bool)
        && (!changed.hasAny(['show_greeting_translations'])
          || data.show_greeting_translations is bool)
        && (!changed.hasAny(['wishbox_suggestions_enabled'])
          || data.wishbox_suggestions_enabled is bool)
        && (!changed.hasAny(['song_rec_enabled'])
          || data.song_rec_enabled is bool)
        && (!changed.hasAny(['song_rec_same_artist'])
          || data.song_rec_same_artist is bool)
        && (!changed.hasAny(['song_rec_scope'])
          || isSafeSongRecScopeValue(data.song_rec_scope))
        && (!changed.hasAny(['song_rec_tempo'])
          || isSafeSongRecTempoValue(data.song_rec_tempo))
        && (!changed.hasAny(['song_rec_familiarity'])
          || isSafeSongRecFamiliarityValue(data.song_rec_familiarity))
        && (!changed.hasAny(['song_rec_count'])
          || isSafeSongRecCountValue(data.song_rec_count))
        && (!changed.hasAny(['useAlternativeEmail'])
          || data.useAlternativeEmail is bool)
        && (!changed.hasAny(['language'])
          || isSafeOptionalText(data, 'language', 12))
        && (!changed.hasAny(['selected_language'])
          || isSafeOptionalText(data, 'selected_language', 12))
        && (!changed.hasAny(['fcm_token_platform'])
          || (data.fcm_token_platform is string
            && (data.fcm_token_platform == 'ios'
              || data.fcm_token_platform == 'android'
              || data.fcm_token_platform == 'web')))
        && (!changed.hasAny(['fcm_token'])
          || isSafeOptionalText(data, 'fcm_token', 4096))
        && (!changed.hasAny(['fcm_token_updated_at'])
          || data.fcm_token_updated_at is timestamp)
        && (!changed.hasAny(['emailChangeRequestedAt'])
          || data.emailChangeRequestedAt == null
          || data.emailChangeRequestedAt is timestamp)
        && (!changed.hasAny(['email_history'])
          || (data.email_history is list && data.email_history.size() <= 50))
        && (!changed.hasAny(['dj_notif_awaiting_first_device_seed'])
          || data.dj_notif_awaiting_first_device_seed is bool)
        && (!changed.hasAny(['notifyNewWishes'])
          || data.notifyNewWishes is bool)
        && (!changed.hasAny(['enableNotificationSound'])
          || data.enableNotificationSound is bool)
        && (!changed.hasAny(['show_status_notification'])
          || data.show_status_notification is bool)
        && (!changed.hasAny(['mic_sensitivity'])
          || (data.mic_sensitivity is number
            && data.mic_sensitivity >= 0.5
            && data.mic_sensitivity <= 2.0))
        && (!changed.hasAny(['recognition_threshold'])
          || (data.recognition_threshold is number
            && data.recognition_threshold >= 0
            && data.recognition_threshold <= 1))
        && (!changed.hasAny(['shazam_scan_interval_seconds'])
          || (data.shazam_scan_interval_seconds is number
            && data.shazam_scan_interval_seconds >= 15
            && data.shazam_scan_interval_seconds <= 300))
        && (!changed.hasAny(['hasSeenQuickstart'])
          || (data.hasSeenQuickstart is bool && data.hasSeenQuickstart == true))
        && (!changed.hasAny(['hasCompletedProfile'])
          || data.hasCompletedProfile is bool)
        && (!changed.hasAny(['birthDate'])
          || data.birthDate is timestamp)
        && (!changed.hasAny(['read_announcements'])
          || (data.read_announcements is list && data.read_announcements.size() <= 200))
        && (!changed.hasAny(['photoURL'])
          || data.photoURL == null
          || isSafeOptionalText(data, 'photoURL', 2048))
        && (!changed.hasAny(['djLogoUrl'])
          || data.djLogoUrl == null
          || isSafeOptionalText(data, 'djLogoUrl', 2048))
        && (!changed.hasAny(['dj_logo_url'])
          || data.dj_logo_url == null
          || isSafeOptionalText(data, 'dj_logo_url', 2048))
        && (!changed.hasAny(['showLocationOnPdf'])
          || data.showLocationOnPdf is bool)
        && (!changed.hasAny(['showPhoneOnPdf'])
          || data.showPhoneOnPdf is bool)
        && (!changed.hasAny(['showEmailOnPdf'])
          || data.showEmailOnPdf is bool)
        && (!changed.hasAny(['showAltEmailOnPdf'])
          || data.showAltEmailOnPdf is bool)
        && (!changed.hasAny(['last_app_system_locale_tag'])
          || isSafeOptionalText(data, 'last_app_system_locale_tag', 80));
    }

    function userOwnerSelfServicePatchAllowed() {
      return userSelfServiceChangedKeysAllowed()
        && userSelfServiceChangedValuesSafe();
    }

    /**
     * Profilbild / DJ-Logo — installierte App: set(merge) nur dieser Keys.
     * Deploy-Bump: 2026-08-08 media-url owner patch v4
     */
