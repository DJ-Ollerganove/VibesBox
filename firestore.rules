    function partyOwnerLifecyclePatchValuesSafe() {
      let data = request.resource.data;
      let changed = request.resource.data.diff(resource.data).changedKeys();
      return (!changed.hasAny(['is_paused']) || data.is_paused is bool)
        && (!changed.hasAny(['pause_log']) || (
          data.pause_log is list && data.pause_log.size() <= 500
        ))
        && (!changed.hasAny(['lifecycle_status'])
          || isSafeOptionalText(data, 'lifecycle_status', 40))
        && (!changed.hasAny(['finished_at']) || data.finished_at is timestamp)
        && (!changed.hasAny(['finished_by'])
