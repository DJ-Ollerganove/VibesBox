#!/bin/bash
# Xcode 27 / macOS 27: `lipo -verify_arch` accepts exactly one architecture.
# Flutter still passes every slice in one call (`arm64 x86_64`) and treats
# the failure as a missing arch. Verify each slice on its own.
if [[ "${2:-}" == "-verify_arch" && $# -gt 3 ]]; then
  file="$1"
  shift 2
  for arch in "$@"; do
    /usr/bin/lipo "$file" -verify_arch "$arch" || exit $?
  done
  exit 0
fi
exec /usr/bin/lipo "$@"
