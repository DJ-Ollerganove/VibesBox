    /** Pause, Beenden, Start, Nachlaufzeit — nur geänderte Felder, kein Full-Doc-isSafePartyData. */
    function partyOwnerLifecyclePatchAllowed(partyId) {
      return (isAdmin() || isPartyOwnedByCurrentUser(partyId))
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
