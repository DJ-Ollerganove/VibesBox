        : collection == 'shazam_history' ? isSafeCommonData(data)
        : collection == 'social_media_links' ? isSafeSocialLinksData(data)
        : collection == 'titles' ? isSafeWishData(data)
        : collection == 'contact_info' ? isSafeContactInfoData(data)
        : collection == 'todos' ? isSafeTodoData(data)
        : collection == 'wunschbox_artist' ? isSafeWishData(data)
        : collection == 'wunschbox_genres' ? isSafeCommonData(data)
        : collection == 'wunschbox_titel' ? isSafeWishData(data)
        : false;
    }

    function isSafeCommonData(data) {
      return isSafeUserData(data)
        && isSafeWishData(data)
        && isSafePartyData(data)
        && isSafeAnnouncementData(data)
        && isSafeAppConfigData(data)
        && isSafeTodoData(data);
    }

    function isUserOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    /// Master-Admin-UID (AppConfig.adminDjId) — Plattform-Inhaber.
    function isPlatformAdminUid() {
      return request.auth.uid == 'rtJXMTULzTPUz0xtdQOw9Jm8SGD3';
    }

    /// Admin in der App: `users.admin == true`, Custom Claim, oder `role_id` → roles/{id}.name == 'Admin'.
    function userHasAdminRoleFromRolesCollection() {
      return authUserDocExists()
        && authUserData().role_id is string
        && authUserData().role_id.size() > 0
        && exists(/databases/$(database)/documents/roles/$(authUserData().role_id))
        && get(/databases/$(database)/documents/roles/$(authUserData().role_id)).data.name == 'Admin';
    }

    function isAdmin() {
      return request.auth != null
        && (
          isPlatformAdminUid()
          || request.auth.token.admin == true
          || (
            authUserDocExists()
            && 'admin' in authUserData()
            && authUserData().admin == true
          )
          || userHasAdminRoleFromRolesCollection()
        );
    }

    function isSafeRbToolLive(data) {
      return data != null
        && data.keys().hasOnly([
          'sessionId',
          'connected',
          'source',
          'nowPlaying',
          'decks',
          'history',
          'updatedAt'
        ])
        && data.sessionId is string
        && data.sessionId.size() > 0
        && data.sessionId.size() <= 80
        && data.connected is bool
        && data.source is string
        && data.source.size() <= 40
        && data.decks is list
        && data.decks.size() <= 4
        && data.history is list
        && data.history.size() <= 50
        && (data.nowPlaying == null || data.nowPlaying is map);
    }

    function isActiveRbTool() {
      return request.auth != null
        && request.auth.token.role == 'rb_tool'
        && request.auth.token.sessionId is string
        && request.auth.token.sessionId.size() > 0
        && exists(/databases/$(database)/documents/rb_tool_sessions/$(request.auth.token.sessionId))
        && get(/databases/$(database)/documents/rb_tool_sessions/$(request.auth.token.sessionId)).data.active == true;
    }

    function isSafeSongSuggestions(data) {
      return data != null
        && data.artist is string
        && data.artist.size() > 0
        && data.artist.size() <= 200
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.version is string
        && data.version.size() <= 80
        && data.suggestions is list
        && data.suggestions.size() <= 20;
    }

    function isSafeSongTransitions(data) {
      return data != null
        && data.from_artist is string
        && data.from_artist.size() > 0
        && data.from_artist.size() <= 200
        && data.from_title is string
        && data.from_title.size() > 0
        && data.from_title.size() <= 200
        && data.from_version is string
        && data.from_version.size() <= 80
        && data.next_tracks is map;
    }

    function isSafeSpotifySettingsData(data) {
      return data != null
        && data.keys().hasOnly(['search_blacklist', 'max_song_duration_ms'])
        && data.search_blacklist is list
        && data.search_blacklist.size() <= 120
        && data.max_song_duration_ms is int
        && data.max_song_duration_ms >= 60000
        && data.max_song_duration_ms <= 3600000;
    }

    function isCollectionWhitelisted(collection) {
      return collection in [
        'admin_stats',
        'artists',
        'block_history',
        'blocked_guests',
        'contact_messages',
        'contact_rate_limit',
        'contacts',
        'countries',
        'genres',
        'guest_fingerprints',
        'impressum',
        'language_stats',
        'last_actions',
        'locations',
        'venues',
        'floor_swap_requests',
        'music_history',
        'parties',
        'party_sessions',
        'party_settings',
        'party_status',
        'public_support_tickets',
        'referral_codes',
        'roles',
        'settings',
        'shazam_history',
        'social_media_links',
        'titles',
        'todos',
        'users',
        'wishes',
        'wunschbox_artist',
        'wunschbox_genres',
        'wunschbox_titel',
        'app_config',
        'global_announcements',
        'contact_info'
      ];
    }

    function isResourceOwnerByCommonFields(data) {
      return request.auth != null
        && (
          ('created_by' in data && data.created_by == request.auth.uid)
          || ('createdBy' in data && data.createdBy == request.auth.uid)
          || ('user_id' in data && data.user_id == request.auth.uid)
          || ('userId' in data && data.userId == request.auth.uid)
          || ('uid' in data && data.uid == request.auth.uid)
          || ('owner_id' in data && data.owner_id == request.auth.uid)
          || ('ownerId' in data && data.ownerId == request.auth.uid)
        );
    }

    function isTopLevelDocOwner() {
      return resource != null
        && resource.data != null
        && isResourceOwnerByCommonFields(resource.data);
    }

    function isParentDocOwner(collection, docId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/$(collection)/$(docId))
        && isResourceOwnerByCommonFields(
          get(/databases/$(database)/documents/$(collection)/$(docId)).data
        );
    }

    function isPartyActiveForGuestWish(data) {
      return ('party_id' in data)
        && data.party_id is string
        && data.party_id.size() > 0
        && partyLifecycleIsActive(data.party_id)
        && partyWishboxOpenOrMissing(data.party_id);
    }

    function isPartyOwnedByCurrentUser(partyId) {
      return request.auth != null
        && partyDocExists(partyId)
        && (
          partyData(partyId).created_by == request.auth.uid
          || partyData(partyId).djId == request.auth.uid
          || partyData(partyId).uid == request.auth.uid
          || partyData(partyId).dj_code == request.auth.uid
        );
    }

    function canGuestWriteOwnClientDoc(docId, data) {
      return request.auth == null
        && docId is string
        && data != null
        && ('client_id' in data)
        && data.client_id is string
        && data.client_id == docId;
    }

    function guestIncrementsOnlyTotalGuestCount(partyId) {
      return partyDocExists(partyId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['total_guest_count'])
        && request.resource.data.total_guest_count is number
        && (
          (
            (!('total_guest_count' in resource.data) || resource.data.total_guest_count == null)
            && request.resource.data.total_guest_count == 1
          )
          || (
            'total_guest_count' in resource.data
            && resource.data.total_guest_count is number
            && request.resource.data.total_guest_count == resource.data.total_guest_count + 1
          )
        );
    }

    function isPublicUserProfileKeysOnly(data) {
      return data != null
        && data.keys().hasOnly(['displayName', 'djName', 'photoUrl', 'photoURL', 'publicProfile']);
    }

    /** Party-Zugehoerigkeit aus bereits geladenen Session-/Event-Daten (kein Doc-Read). */
    function canManagePartyBySessionData(data) {
      return request.auth != null
        && (
          ('party_id' in data && isPartyOwnedByCurrentUser(data.party_id))
          || ('partyId' in data && isPartyOwnedByCurrentUser(data.partyId))
        );
    }

    function canManagePartyByData(data) {
      return canManagePartyBySessionData(data);
    }

    function isWishOwnerByData(data) {
      return request.auth != null
        && (
          ('uid' in data && data.uid == request.auth.uid)
          || ('user_id' in data && data.user_id == request.auth.uid)
          || ('userId' in data && data.userId == request.auth.uid)
          || ('created_by' in data && data.created_by == request.auth.uid)
          || ('dj_id' in data && data.dj_id == request.auth.uid)
          || ('djId' in data && data.djId == request.auth.uid)
        );
    }

    /** JWT zuerst (ohne Firestore-Read), dann users/{uid}. */
    function authenticatedUserOwnsWishByDisplayName() {
      return request.auth != null
        && resource.data != null
        && resource.data.name is string
        && (
          ('name' in request.auth.token && request.auth.token.name == resource.data.name)
          || (
            authUserDocExists()
            && 'displayName' in authUserData()
            && authUserData().displayName == resource.data.name
          )
        );
    }

    function canManageWishData(data) {
      return request.auth != null
        && (isWishOwnerByData(data) || canManagePartyByData(data));
    }

    function canGuestUpdateWishData() {
      return request.auth == null
        && resource.data.client_id is string
        && request.resource.data.client_id is string
        && request.resource.data.client_id == resource.data.client_id
        && request.resource.data.party_id == resource.data.party_id
        && isPartyActiveForGuestWish(resource.data);
    }

    function wishDocumentReadable() {
      return (request.auth != null && (
          isAdmin()
          || canManageWishData(resource.data)
          || isWishOwnerByData(resource.data)
          || authenticatedUserOwnsWishByDisplayName()
        ))
        || (
          request.auth == null
          && resource.data.party_id is string
          && resource.data.party_id.size() > 0
          && partyDocExists(resource.data.party_id)
        );
    }

    function canCreateCollectionDoc(collection, data) {
      return request.auth != null
        || (
          collection == 'wishes'
          && isPartyActiveForGuestWish(data)
        );
    }

    /** Öffentlich ohne Login — nur Katalog/Texte, keine PII. */
    function isUnauthPublicCollection(collection) {
      return collection in [
        'settings',
        'impressum',
        'countries',
        'genres',
        'venues',
        'locations',
        'language_stats',
        'roles',
        'global_announcements'
      ];
    }

    function canManageBlockResource() {
      return request.auth != null
        && (
          isAdmin()
          || ('dj_id' in resource.data && resource.data.dj_id == request.auth.uid)
          || (
            'party_id' in resource.data
            && resource.data.party_id is string
            && (
              isPartyOwnedByCurrentUser(resource.data.party_id)
              || isDjBrowserSession(resource.data.party_id)
            )
          )
        );
    }

    function canWriteBlockRequest() {
      return request.auth != null
        && (
          isAdmin()
          || ('dj_id' in request.resource.data && request.resource.data.dj_id == request.auth.uid)
          || (
            'party_id' in request.resource.data
            && request.resource.data.party_id is string
            && isPartyOwnedByCurrentUser(request.resource.data.party_id)
          )
        );
    }

    function guestWishCreateNotPrivileged(data) {
      return (!('is_dj_wish' in data) || data.is_dj_wish == false)
        && (!('status' in data) || data.status in ['pending', 'rejected']);
    }

    function partyListOwnedByAuth() {
      return request.auth != null && (
        isAdmin()
        || (resource.data.created_by is string && resource.data.created_by == request.auth.uid)
        || (resource.data.djId is string && resource.data.djId == request.auth.uid)
        || (resource.data.uid is string && resource.data.uid == request.auth.uid)
        || (resource.data.dj_code is string && resource.data.dj_code == request.auth.uid)
      );
    }

    function partyGuestDiscoveryListAllowed() {
      return request.auth == null
        && resource.data.status == 'active'
        && resource.data.lifecycle_status in ['active', 'standby']
        && resource.data.end_date is timestamp
        && resource.data.end_date >= request.time - duration.value(14, 'd');
    }

    function partyHasNonEmptyJoinCode(data) {
      return (data.party_code is string && data.party_code.size() > 0)
        || (data.fixed_party_code is string && data.fixed_party_code.size() > 0)
        || (data.party_code is int && data.party_code > 0)
        || (data.party_code is float && data.party_code > 0)
        || (data.fixed_party_code is int && data.fixed_party_code > 0)
        || (data.fixed_party_code is float && data.fixed_party_code > 0);
    }

    function partyLifecycleAllowsJoinByCode(data) {
      return !('lifecycle_status' in data)
        || data.lifecycle_status == null
        || data.lifecycle_status in ['active', 'finished', 'standby', 'upcoming'];
    }

    function partyDjJoinCodeCollisionListAllowed() {
      return request.auth != null
        && request.query.limit <= 25
        && partyHasNonEmptyJoinCode(resource.data);
    }

    /** Öffentliche Venue-Partys für Floor-/Zeit-Konflikt (DJ-übergreifend). */
    function partyVenueConflictListAllowed() {
      return request.auth != null
        && request.query.limit <= 50
        && ('venue_id' in resource.data)
        && resource.data.venue_id is string
        && resource.data.venue_id.size() > 0
        && resource.data.party_type == 'public';
    }

    function partyGuestJoinCodeListAllowed() {
      return request.auth == null
        && partyLifecycleAllowsJoinByCode(resource.data)
        && partyHasNonEmptyJoinCode(resource.data);
    }

    match /users/{userId} {
      allow get: if isUserOwner(userId) || isAdmin() || isPublicUserProfileKeysOnly(resource.data)
        || (isActiveRbTool() && userId == request.auth.token.ownerUid);
      allow list: if isUserOwner(userId) || isAdmin();
      allow delete: if isUserOwner(userId) || isAdmin();
      allow create: if (isUserOwner(userId) && isSafeUserRegistrationPayload(request.resource.data) && clientCannotSeedDjB2bFields(request.resource.data))
        || isAdmin()
        // Logo/Profilbild: falls Doc noch fehlt (set merge als create)
        || (isUserOwner(userId)
          && request.resource.data.keys().hasOnly(['dj_logo_url', 'djLogoUrl', 'photoURL']));
      allow update: if (request.auth != null
        && isAdmin()
        && userPreservesDeviceBlockFusion()
        && userPreservesDjB2bLedger())
        // Logo/Profilbild: eigener, schlanker Pfad (umgeht Legacy-/Fusion-Blocker)
        || (isUserOwner(userId) && userOwnerMediaUrlPatchAllowed())
        // Fallback: Owner-Patch ohne privilegierte Felder (isSafeUserData-Legacy)
        || (isUserOwner(userId) && userOwnerNonPrivilegedPatchAllowed())
        || (isUserOwner(userId)
          && userPreservesDeviceBlockFusion()
          && userPreservesDjB2bLedger()
          && userOwnerCannotEscalatePrivileges()
          && (
            isSafeUserData(request.resource.data)
            || userOwnerSelfServicePatchAllowed()
          ));

      match /social_media_links/{docId} {
        allow read: if true;
        allow delete: if isUserOwner(userId) || isAdmin();
        allow create, update: if (isUserOwner(userId) || isAdmin())
          && isSafeSocialLinksData(request.resource.data);
      }

      match /contact_info/{docId} {
        allow read: if isUserOwner(userId) || isAdmin();
        allow delete: if isUserOwner(userId) || isAdmin();
        allow create, update: if (isUserOwner(userId) || isAdmin())
          && isSafeContactInfoData(request.resource.data);
      }

      match /history/{docId} {
        allow read: if isUserOwner(userId) || isAdmin();
        allow delete: if isUserOwner(userId) || isAdmin();
        allow create, update: if (isUserOwner(userId) || isAdmin())
          && isSafeHistoryData(request.resource.data);
      }

      match /saved_tracks/{docId} {
        allow read: if isUserOwner(userId) || isAdmin();
        allow delete: if isUserOwner(userId) || isAdmin();
        allow create, update: if (isUserOwner(userId) || isAdmin())
          && isSafeSavedTrackData(request.resource.data)
          && docId is string
          && docId.size() > 0
          && docId.size() <= 200;
      }

      function isSafeDjLibrarySetlistDoc(data) {
        return data != null
          && data.keys().hasOnly([
            'title', 'tracks', 'targetCount', 'createdAt', 'updatedAt',
            'partyId', 'partyName', 'partyIds', 'partyNames',
          ])
          && isSafeText(data.title, 200)
          && data.title.size() > 0
          && data.tracks is list
          && data.tracks.size() <= 1000
          && (!('targetCount' in data)
            || (data.targetCount is int
              && data.targetCount >= 0
              && data.targetCount <= 1000))
          && isSafeOptionalText(data, 'partyId', 120)
          && isSafeOptionalText(data, 'partyName', 200)
          && (!('partyIds' in data)
            || (data.partyIds is list
              && data.partyIds.size() <= 50
              && data.partyIds.size() >= 0))
          && (!('partyNames' in data) || data.partyNames is map)
          && (!('createdAt' in data) || data.createdAt is timestamp)
          && (!('updatedAt' in data) || data.updatedAt is timestamp);
      }

      // DJ-eigene Setlisten-Bibliothek — nur users/{uid}/dj_setlists, volles CRUD.
      match /dj_setlists/{listId} {
        allow read: if isUserOwner(userId) || isAdmin();
        allow delete: if isUserOwner(userId) || isAdmin();
        allow create, update: if (isUserOwner(userId) || isAdmin())
          && isSafeDjLibrarySetlistDoc(request.resource.data)
          && listId is string
          && listId.size() > 0
          && listId.size() <= 128;
      }

      match /settings/{docId} {
        allow read: if isUserOwner(userId) || isAdmin() || docId == 'results_per_page';
        allow delete: if isUserOwner(userId) || isAdmin();
        allow create, update: if (isUserOwner(userId) || isAdmin())
          && isSafeSettingsData(request.resource.data);
      }

      function isSafeDjDevicePrefsData(data) {
        return data != null
          && data.keys().hasOnly([
            'notifyNewWishes',
            'enableNotificationSound',
            'show_status_notification',
            'platform',
            'updatedAt',
          ])
          && (!('notifyNewWishes' in data) || data.notifyNewWishes is bool)
          && (!('enableNotificationSound' in data) || data.enableNotificationSound is bool)
          && (!('show_status_notification' in data) || data.show_status_notification is bool)
          && (!('platform' in data) || (
            data.platform is string
            && data.platform.size() > 0
            && data.platform.size() <= 40
          ))
          && (!('updatedAt' in data) || data.updatedAt is timestamp);
      }

      match /dj_device_prefs/{deviceDocId} {
        allow read: if isUserOwner(userId) || isAdmin();
        allow delete: if isUserOwner(userId) || isAdmin();
        allow create, update: if (isUserOwner(userId) || isAdmin())
          && isSafeDjDevicePrefsData(request.resource.data)
          && deviceDocId is string
          && deviceDocId.size() > 0
          && deviceDocId.size() <= 128;
      }

      match /guest_live/{docId} {
        allow read: if docId == 'wishbox';
        allow delete: if isUserOwner(userId) || isAdmin();
        allow create, update: if (isUserOwner(userId) || isAdmin())
          && docId == 'wishbox'
          && isSafeGuestLiveWishboxData(request.resource.data);
      }

      match /venue_bookmarks/{bookmarkId} {
        allow read: if isUserOwner(userId) || isAdmin();
        allow delete: if isUserOwner(userId) || isAdmin();
        allow create, update: if isUserOwner(userId)
          && isSafeVenueBookmarkData(request.resource.data);
      }

      match /dj_b2b_referrals/{refId} {
        allow read: if isUserOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }

      match /{subDocument=**} {
        allow read: if isUserOwner(userId) || isAdmin();
        allow delete: if isUserOwner(userId) || isAdmin();
        allow create, update: if isUserOwner(userId)
          && isSafeCommonData(request.resource.data);
      }
    }

    match /admin_config/global_settings {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admin_config/app_update {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Desktop-Tool VibesBox Sync: eine Lese-Anfrage beim Start, Schreiben nur Admin.
    match /admin_config/sync_tool {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admin_config/apple_developer_token {
      allow read, write: if false;
    }

    match /admin_config/spotify_settings {
      allow read: if true;
      allow create, update: if isAdmin()
        && isSafeSpotifySettingsData(request.resource.data);
      allow delete: if false;
    }

    match /admin_config/vibesbox_social {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Arabisch-Vorschau: Allowlist freigeschalteter DJ-UIDs (App-Sprachmenü).
    match /admin_config/arabic_preview {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /admin_config/{docId} {
      allow read, write: if false;
    }

    function isCountrySeedData(data) {
      return data != null
        && data.keys().hasOnly(['name', 'code'])
        && data.name is string
        && data.code is string
        && data.name.size() > 0 && data.name.size() <= 120
        && data.code.size() > 0 && data.code.size() <= 4;
    }

    match /countries/{docId} {
      allow read: if true;
      allow create: if isAdmin()
        || (
          isCountrySeedData(request.resource.data)
          && request.resource.data.code == docId
        );
      allow update: if isAdmin()
        || (
          isCountrySeedData(request.resource.data)
          && request.resource.data.code == docId
          && resource.data.code == docId
        );
      allow delete: if isAdmin();
    }

    match /venues/{venueId} {
      allow get, list: if true;
      allow create: if request.auth != null
        && isSafeVenueData(request.resource.data)
        && request.resource.data.created_by == request.auth.uid;
      allow update: if request.auth != null
        && isSafeVenueData(request.resource.data)
        && (
          isAdmin()
          || resource.data.created_by == request.auth.uid
        );
      allow delete: if isAdmin();
    }

    match /floor_swap_requests/{requestId} {
      allow read: if request.auth != null
        && (
          isAdmin()
          || resource.data.from_dj_id == request.auth.uid
          || resource.data.to_dj_id == request.auth.uid
        );
      allow create: if request.auth != null
        && isSafeFloorSwapRequestData(request.resource.data)
        && request.resource.data.from_dj_id == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if request.auth != null
        && isSafeFloorSwapRequestData(request.resource.data)
        && (
          isAdmin()
          || (
            resource.data.to_dj_id == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status in ['accepted', 'rejected']
          )
          || (
            resource.data.from_dj_id == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled'
          )
        );
      allow delete: if isAdmin();
    }

    /** Global eindeutige Join-Codes (privat + öffentliche Einmal-Codes). */
    match /party_code_index/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.party_type in ['private', 'public']
        && request.resource.data.party_id is string
        && request.resource.data.party_id.size() > 0
        && request.resource.data.created_by == request.auth.uid
        && (!('scope' in request.resource.data)
          || request.resource.data.scope == 'global')
        && !exists(/databases/$(database)/documents/party_code_index/$(code));
      allow delete: if request.auth != null
        && resource.data.created_by == request.auth.uid;
      allow update: if false;
    }

    match /party_status/{statusId} {
      allow read: if request.auth != null
        && (
          isAdmin()
          || resource.data.dj_code == request.auth.uid
        );
      allow create: if request.auth != null
        && isSafePartyStatusData(request.resource.data)
        && request.resource.data.dj_code == request.auth.uid;
      allow update: if request.auth != null
        && isSafePartyStatusData(request.resource.data)
        && (
          isAdmin()
          || resource.data.dj_code == request.auth.uid
        );
      allow delete: if request.auth != null
        && (
          isAdmin()
          || resource.data.dj_code == request.auth.uid
        );
    }

    match /locations/{locationId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null
        && (
          resource.data.created_by == request.auth.uid
          || (('is_public' in resource.data) && resource.data.is_public == true)
        );
      allow create: if request.auth != null
        && isSafePartyData(request.resource.data)
        && (!('is_public' in request.resource.data) || request.resource.data.is_public is bool)
        && request.resource.data.created_by == request.auth.uid;
      allow update: if request.auth != null
        && (isAdmin() || resource.data.created_by == request.auth.uid)
        && isSafePartyData(request.resource.data)
        && (!('is_public' in request.resource.data) || request.resource.data.is_public is bool);
      allow delete: if isAdmin();
    }

    function isSafeDjSetlistShape(data) {
      return data != null
        && data.keys().hasOnly(['tracks', 'updatedAt', 'createdBy', 'targetCount', 'partyName'])
        && data.createdBy is string
        && data.createdBy.size() > 0
        && data.createdBy.size() <= 128
        && data.tracks is list
        && data.tracks.size() <= 1000
        && (!('targetCount' in data)
          || (data.targetCount is int
            && data.targetCount >= 0
            && data.targetCount <= 1000))
        && (!('updatedAt' in data) || data.updatedAt is timestamp)
        && (!('partyName' in data)
            || isSafeText(data.partyName, 200));
    }

    function isSafeDjSetlistCreate(data) {
      return isSafeDjSetlistShape(data)
        && data.createdBy == request.auth.uid;
    }

    function canManagePartySetlist(partyId) {
      return request.auth != null
        && (
          isAdmin()
          || isPartyOwnedByCurrentUser(partyId)
          || (resource != null && resource.data.createdBy == request.auth.uid)
          || isDjBrowserSession(partyId)
        );
    }

    // Party-Setliste dj_setlists/{partyId}: DJ der Party, createdBy oder DJ-Browser.
    match /dj_setlists/{partyId} {
      allow get: if request.auth != null
        && (
          isAdmin()
          || isPartyOwnedByCurrentUser(partyId)
          || (resource != null && resource.data.createdBy == request.auth.uid)
          || isDjBrowserSession(partyId)
        );
      allow list: if request.auth != null
        && resource.data.createdBy == request.auth.uid;
      allow create: if request.auth != null
        && (isAdmin() || isPartyOwnedByCurrentUser(partyId))
        && isSafeDjSetlistCreate(request.resource.data);
      allow update: if canManagePartySetlist(partyId)
        && isSafeDjSetlistShape(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if canManagePartySetlist(partyId);
    }

    function isSafeDjSongBlacklistDoc(data) {
      return data != null
        && data.keys().hasOnly(['entries', 'updatedAt', 'enabled', 'guest_block'])
        && data.entries is list
        && data.entries.size() <= 201
        && (!('updatedAt' in data) || data.updatedAt is timestamp)
        && (!('enabled' in data) || data.enabled is bool)
        && (!('guest_block' in data) || data.guest_block is bool);
    }

    // Eine Blacklist pro DJ — lesen öffentlich (Gast-Submit), Writes nur der DJ selbst.
    match /dj_song_blacklists/{djId} {
      allow get: if true;
      allow list: if request.auth != null
        && (request.auth.uid == djId || isAdmin());
      allow delete: if request.auth != null
        && (request.auth.uid == djId || isAdmin());
      allow create, update: if request.auth != null
        && (request.auth.uid == djId || isAdmin())
        && djId is string
        && djId.size() > 0
        && djId.size() <= 128
        && isSafeDjSongBlacklistDoc(request.resource.data);
    }

    function isSafePartySongBlacklistDoc(data) {
      return data != null
        && data.keys().hasOnly(['entries', 'updatedAt'])
        && data.entries is list
        && data.entries.size() <= 200
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // Temporäre Blacklist einer Party — lesen öffentlich (Gast-Submit), Writes nur Party-DJ/Admin.
    match /party_song_blacklists/{partyId} {
      allow get: if true;
      allow list: if request.auth != null
        && (isAdmin() || isPartyOwnedByCurrentUser(partyId));
      allow delete: if request.auth != null
        && (isAdmin() || isPartyOwnedByCurrentUser(partyId));
      allow create, update: if request.auth != null
        && (isAdmin() || isPartyOwnedByCurrentUser(partyId))
        && partyId is string
        && partyId.size() > 0
        && partyId.size() <= 128
        && isSafePartySongBlacklistDoc(request.resource.data);
    }

    match /parties/{partyId} {
      allow get: if true;
      allow list: if partyListOwnedByAuth()
        || partyGuestDiscoveryListAllowed()
        || partyGuestJoinCodeListAllowed()
        || partyDjJoinCodeCollisionListAllowed()
        || partyVenueConflictListAllowed();
      allow create: if request.auth != null
        && isSafePartyData(request.resource.data)
        && (
          isAdmin()
          || ('created_by' in request.resource.data && request.resource.data.created_by == request.auth.uid)
          || ('djId' in request.resource.data && request.resource.data.djId == request.auth.uid)
          || ('uid' in request.resource.data && request.resource.data.uid == request.auth.uid)
          || ('dj_code' in request.resource.data && request.resource.data.dj_code == request.auth.uid)
        );
      allow update: if partyGraceHideWishesPatchAllowed(partyId)
        || preWishesPausedPatchAllowed(partyId)
        || partyPreWishSettingsPatchAllowed(partyId)
        || djBrowserOpenWishPinPatchAllowed(partyId)
        || partyOwnerDjLogoPatchAllowed(partyId)
        || (request.auth != null
          && (
            (
              (isAdmin() || isPartyOwnedByCurrentUser(partyId))
              && (
                isSafePartyData(request.resource.data)
                || openWishOrderPartyPatchAllowed()
                || partyOwnerLifecyclePatchAllowed(partyId)
              )
            )
          ))
        || guestIncrementsOnlyTotalGuestCount(partyId);
      allow delete: if request.auth != null
        && (isAdmin() || isPartyOwnedByCurrentUser(partyId));

      match /guests/{guestId} {
        allow read: if request.auth != null
          || (request.auth == null && partyDocExists(partyId));
        allow create: if partyDocExists(partyId)
          && (
            canGuestWriteOwnClientDoc(guestId, request.resource.data)
            || (
              request.auth != null
              && request.resource.data.client_id is string
              && request.resource.data.client_id == guestId
              && request.resource.data.keys().hasOnly(['client_id', 'last_seen', 'language'])
            )
          );
        allow update: if partyDocExists(partyId)
          && (
            canGuestWriteOwnClientDoc(guestId, request.resource.data)
            || (
              request.auth != null
              && resource.data.client_id is string
              && resource.data.client_id == guestId
              && request.resource.data.client_id == guestId
              && request.resource.data.diff(resource.data).changedKeys().hasOnly(['last_seen', 'language'])
            )
          );
      }

      match /guestStats/{guestId} {
        allow read: if request.auth != null
          || (
            request.auth == null
            && partyDocExists(partyId)
            && guestId is string
            && (
              !exists(/databases/$(database)/documents/parties/$(partyId)/guestStats/$(guestId))
              || (
                resource.data.client_id is string
                && resource.data.client_id == guestId
              )
            )
          );
        allow create, update: if partyDocExists(partyId)
          && isSafeGuestStatsData(request.resource.data)
          && (
            canGuestWriteOwnClientDoc(guestId, request.resource.data)
            || (
              guestId is string
              && request.resource.data.client_id is string
              && request.resource.data.client_id == guestId
            )
          );
      }

      /** Server-gepflegte Wunsch-Zähler (Cloud Functions) — nur Admin lesen. */
      match /stats/{docId} {
        allow read: if isAdmin();
        allow write: if false;
      }

      function wishPartyIdMatchesPath(data) {
        return data != null
          && (
            !('party_id' in data)
            || (
              data.party_id is string
              && data.party_id == partyId
            )
          );
      }

      function isAllowedWishStatusValue(status) {
        return status is string
          && status in ['pending', 'played', 'rejected'];
      }

      /** Status/Ablehnung/Wiederherstellung/Shazam — nur geänderte Felder, kein Full-Doc-isSafeWishData (Legacy-Wünsche). */
      function wishStatusPatchChangedKeysOnly() {
        return request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status',
          'status_changed_at',
          'playedAt',
          'played_at',
          'rejectedAt',
          'rejected_at',
          'rejection_reason',
          'auto_rejected_by_block',
          'auto_rejected_by_blacklist',
          'recognized_at',
          'auto_recognized',
          'isSeen',
          'is_seen',
          'is_favorite',
        ]);
      }

      function wishStatusPatchValuesSafe() {
        let data = request.resource.data;
        return (!('status' in data) || isAllowedWishStatusValue(data.status))
          && (!('auto_recognized' in data) || data.auto_recognized is bool)
          && (!('auto_rejected_by_blacklist' in data)
            || data.auto_rejected_by_blacklist is bool)
          && (!('isSeen' in data) || data.isSeen is bool)
          && (!('is_seen' in data) || data.is_seen is bool)
          && (!('is_favorite' in data) || data.is_favorite is bool);
      }

      /** Gast (auch Auth): Dubletten-Aggregation auf Original-Wunsch derselben Party. */
      function guestWishDuplicateAggregationPatchAllowed(partyId) {
        return resource.data != null
          && wishPartyIdMatchesPath(resource.data)
          && wishPartyIdMatchesPath(request.resource.data)
          && partyDocExists(partyId)
          && (
            isPartyActiveForGuestWish(resource.data)
            || (
              resource.data.is_pre_wish == true
              && resource.data.pre_wish_published != true
            )
          )
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'duplicate_count',
            'requested_by',
            'createdAt_list',
            'greetings',
            'is_registered_users',
            'duplicate_updated_at',
            'pre_wish_published',
          ])
          && (!('duplicate_count' in request.resource.data)
            || request.resource.data.duplicate_count is int)
          && (!('pre_wish_published' in request.resource.data)
            || request.resource.data.pre_wish_published is bool)
          && (!('requested_by' in request.resource.data)
            || (request.resource.data.requested_by is list
              && request.resource.data.requested_by.size() <= 200))
          && (!('greetings' in request.resource.data)
            || (request.resource.data.greetings is list
              && request.resource.data.greetings.size() <= 200))
          && (!('duplicate_count' in request.resource.data)
            || (
              request.resource.data.duplicate_count is int
              && request.resource.data.duplicate_count >= 0
              && (
                (!('duplicate_count' in resource.data)
                  && request.resource.data.duplicate_count <= 1)
                || (
                  'duplicate_count' in resource.data
                  && resource.data.duplicate_count is int
                  && request.resource.data.duplicate_count <= resource.data.duplicate_count + 1
                )
              )
            ));
      }

      function partyOwnerWishStatusPatchAllowed(partyId) {
        return request.auth != null
          && resource.data != null
          && wishPartyIdMatchesPath(resource.data)
          && wishPartyIdMatchesPath(request.resource.data)
          && (isAdmin() || isPartyOwnedByCurrentUser(partyId))
          && wishStatusPatchChangedKeysOnly()
          && wishStatusPatchValuesSafe();
      }

      /** DJ-Browser: gezielte Wunsch-Patches ohne Full-Doc-isSafeWishData. */
      function djBrowserWishPatchAllowed() {
        return request.auth != null
          && isDjBrowserSession(partyId)
          && resource.data != null
          && wishPartyIdMatchesPath(resource.data)
          && wishPartyIdMatchesPath(request.resource.data)
          && (
            (
              request.resource.data.diff(resource.data).changedKeys().hasOnly(['is_favorite'])
              && request.resource.data.is_favorite is bool
            )
            || (
              wishStatusPatchChangedKeysOnly()
              && wishStatusPatchValuesSafe()
            )
          );
      }

      function wishSubcollectionReadable() {
        return (request.auth != null && (
            isAdmin()
            || isPartyOwnedByCurrentUser(partyId)
            || isDjBrowserSession(partyId)
            || wishDocumentReadable()
            || isPartyOwnedByRbTool(partyId)
          ))
          || (request.auth == null && partyDocExists(partyId));
      }

      function isPartyOwnedByRbTool(partyId) {
        return isActiveRbTool()
          && request.auth.token.ownerUid is string
          && exists(/databases/$(database)/documents/parties/$(partyId))
          && get(/databases/$(database)/documents/parties/$(partyId)).data.created_by
            == request.auth.token.ownerUid;
      }

      match /wishes/{wishId} {
        allow read: if wishSubcollectionReadable();
        allow create: if isSafeWishData(request.resource.data)
          && wishPartyIdMatchesPath(request.resource.data)
          && (
            (
              request.auth != null
              && (
                isAdmin()
                || canManageWishData(request.resource.data)
                || isPartyOwnedByCurrentUser(partyId)
                || isDjBrowserManualWishCreate(request.resource.data, partyId)
              )
            )
            || (
              request.auth == null
              && guestWishCreateNotPrivileged(request.resource.data)
              && (
                isPartyActiveForGuestWish(request.resource.data)
                || isPreWishGuestCreate(request.resource.data)
              )
            )
          );
        allow update: if preWishPublishPatchAllowed(partyId)
          || djBrowserWishPatchAllowed()
          || partyOwnerWishStatusPatchAllowed(partyId)
          || guestWishDuplicateAggregationPatchAllowed(partyId)
          || (
            isSafeWishData(request.resource.data)
            && wishPartyIdMatchesPath(request.resource.data)
            && wishPartyIdMatchesPath(resource.data)
            && (
              (
                request.auth != null
                && (
                  isAdmin()
                  || isPartyOwnedByCurrentUser(partyId)
                  || isDjBrowserSession(partyId)
                  || canManageWishData(resource.data)
                  || canManageWishData(request.resource.data)
                  || authenticatedUserOwnsWishByDisplayName()
                )
              )
              || (
                canGuestUpdateWishData()
                && !request.resource.data.diff(resource.data).changedKeys()
                  .hasAny(['status', 'is_dj_wish'])
              )
            )
          );
        // DJ/Admin: alle Status; andere nur pending (Gast-eigene Aufräumen).
        allow delete: if request.auth != null
          && (
            isAdmin()
            || isPartyOwnedByCurrentUser(partyId)
            || isDjBrowserSession(partyId)
            || (
              (!('status' in resource.data) || resource.data.status == 'pending')
              && (
                canManageWishData(resource.data)
                || authenticatedUserOwnsWishByDisplayName()
              )
            )
          );
      }

      /** Admin-Home Wishbox-Toggle-Protokoll. */
      match /status_logs/{logId} {
        allow read: if isAdmin() || isPartyOwnedByCurrentUser(partyId);
        allow create: if (isAdmin() || isPartyOwnedByCurrentUser(partyId))
          && request.resource.data.keys().hasOnly(['status', 'timestamp', 'action_by'])
          && request.resource.data.status is string
          && request.resource.data.status.size() <= 40
          && request.resource.data.action_by is string
          && request.resource.data.action_by == request.auth.uid
          && (!('timestamp' in request.resource.data)
            || request.resource.data.timestamp is timestamp);
        allow update, delete: if isAdmin();
      }
    }

    match /guest_fingerprints/{clientId} {
      // PWA liest vor dem Upsert — unauth muss get dürfen.
      allow get: if true;
      allow list: if request.auth != null;
      allow create, update: if clientId is string
        && request.resource.data != null
        && request.resource.data.client_id is string
        && request.resource.data.client_id == clientId;
    }

    match /social_media_links/{uid} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && (isAdmin() || request.auth.uid == uid);
    }

    match /blocked_devices/{docId} {
      allow get: if true;
      allow list: if canManageBlockResource();
      allow create: if canWriteBlockRequest();
      allow update, delete: if canManageBlockResource();
    }

    match /blocked_guests/{docId} {
      allow get: if true;
      allow list: if canManageBlockResource();
      allow create: if canWriteBlockRequest();
      allow update, delete: if canManageBlockResource();
    }

    // Eigene Regeln — nicht über Catch-all + isSafeHistoryData (andere Feldmenge).
    match /block_history/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.client_id is string
        && request.resource.data.client_id.size() > 0
        && request.resource.data.client_id.size() <= 200
        && request.resource.data.dj_id is string
        && request.resource.data.dj_id == request.auth.uid
        && request.resource.data.party_id is string
        && request.resource.data.party_id.size() > 0
        && request.resource.data.party_id.size() <= 120
        && request.resource.data.timestamp is timestamp
        && isSafeOptionalText(request.resource.data, 'blocked_as_name', 120)
        && isSafeOptionalText(request.resource.data, 'trigger_wish_id', 120)
        && isSafeOptionalText(request.resource.data, 'trigger_wish_title', 400);
      allow update, delete: if request.auth != null
        && (
          isAdmin()
          || (resource.data.dj_id is string && resource.data.dj_id == request.auth.uid)
        );
    }

    match /block_device_fusion_log/{docId} {
      allow read: if request.auth != null        && (
          isAdmin()
          || (resource.data.dj_id is string && resource.data.dj_id == request.auth.uid)
        );
      allow create, update, delete: if false;
    }

    match /party_stats/{docId} {
      allow read: if request.auth != null && (
        isAdmin()
        || (
          resource.data.party_id is string
          && isPartyOwnedByCurrentUser(resource.data.party_id)
        )
      );
      allow create: if request.resource.data.keys().hasOnly([
          'party_id',
          'language',
          'is_logged_in_user',
          'platform',
          'timestamp',
        ])
        && request.resource.data.party_id is string
        && request.resource.data.party_id.size() > 0
        && request.resource.data.party_id.size() <= 120
        && request.resource.data.language is string
        && request.resource.data.language.size() <= 20
        && request.resource.data.is_logged_in_user is bool
        && request.resource.data.platform is string
        && (
          request.resource.data.platform == 'android'
          || request.resource.data.platform == 'ios'
          || request.resource.data.platform == 'web'
          || request.resource.data.platform == 'unknown'
        )
        && request.resource.data.timestamp == request.time
        && partyLifecycleIsActive(request.resource.data.party_id);
      allow update, delete: if false;
    }

    // Legacy root collection (nach Migration leer) — kein Zugriff mehr
    match /wishes/{wishId} {
      allow read, write: if false;
    }

    match /music_history/{sessionId} {
      // Session-Lesen: DJ/Admin/Party-Besitzer; unauthentifiziert wie PWA-Gast (party_id + Party existiert);
      // authentifizierte Gäste (Flutter) gleiche Schwelle — sonst liefert die Sessions-Query leer, Tracks-Subcollection wäre isoliert nicht auffindbar.
      allow read: if (request.auth != null
        && (
          isAdmin()
          || ('djId' in resource.data && resource.data.djId == request.auth.uid)
          || canManagePartyByData(resource.data)
        ))
        || (
          request.auth == null
          && (
            (
              'party_id' in resource.data
              && resource.data.party_id is string
              && resource.data.party_id.size() > 0
              && partyDocExists(resource.data.party_id)
            )
            || (
              'partyId' in resource.data
              && resource.data.partyId is string
              && resource.data.partyId.size() > 0
              && partyDocExists(resource.data.partyId)
            )
          )
        )
        || (
          request.auth != null
          && (
            (
              'party_id' in resource.data
              && resource.data.party_id is string
              && resource.data.party_id.size() > 0
              && partyDocExists(resource.data.party_id)
            )
            || (
              'partyId' in resource.data
              && resource.data.partyId is string
              && resource.data.partyId.size() > 0
              && partyDocExists(resource.data.partyId)
            )
          )
        );
      allow create: if request.auth != null
        && isSafeCommonData(request.resource.data)
        && (
          isAdmin()
          || ('djId' in request.resource.data && request.resource.data.djId == request.auth.uid)
          || canManagePartyByData(request.resource.data)
        );
      allow update: if request.auth != null
        && (
          isAdmin()
          || ('djId' in resource.data && resource.data.djId == request.auth.uid)
          || canManagePartyByData(resource.data)
          || canManagePartyByData(request.resource.data)
        );
      allow delete: if request.auth != null
        && (
          isAdmin()
          || ('djId' in resource.data && resource.data.djId == request.auth.uid)
          || canManagePartyByData(resource.data)
        );

      match /tracks/{trackId} {
        allow read: if request.auth != null
          || (
            exists(musicHistoryDocPath(sessionId))
            && musicHistorySessionData(sessionId).party_id is string
            && partyDocExists(musicHistorySessionData(sessionId).party_id)
          );
        allow create: if canWriteMusicHistoryTracks(sessionId)
          && isSafeMusicHistoryTrackData(request.resource.data);
        allow update: if canWriteMusicHistoryTracks(sessionId)
          && isSafeMusicHistoryTrackData(request.resource.data);
        allow delete: if canWriteMusicHistoryTracks(sessionId);
      }
    }

    match /referral_codes/{codeId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /party_settings/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin()
        && isSafeSettingsData(request.resource.data);
    }

    // Seed Gast/DJ bleibt möglich; Admin-Rolle nur durch Admin.
    match /roles/{roleId} {
      allow read: if true;
      allow create: if isAdmin()
        || (
          request.resource.data.keys().hasOnly(['name', 'level'])
          && request.resource.data.name in ['Gast', 'DJ']
          && request.resource.data.level is int
        );
      allow update, delete: if isAdmin();
    }

    // Admin-To-dos: nur Admin-UI, kein DJ-/Gast-Liste.
    match /todos/{docId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && isSafeTodoData(request.resource.data);
      allow delete: if isAdmin();
    }

    // Kontakt: Anlegen durch eingeloggte App; Lesen nur Admin.
    // PWA speichert über Cloud Function (Admin SDK) in contacts.
    match /contact_messages/{docId} {
      allow create: if request.auth != null
        && isSafeContactInfoData(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    match /contacts/{docId} {
      allow read, write: if isAdmin();
    }

    // Rate-Limit-Docs nur Functions (Admin SDK).
    match /last_actions/{docId} {
      allow read, write: if false;
    }

    match /party_sessions/{docId} {
      allow read, update, delete: if request.auth != null
        && (
          isAdmin()
          || ('dj_id' in resource.data && resource.data.dj_id == request.auth.uid)
          || (
            'party_id' in resource.data
            && resource.data.party_id is string
            && isPartyOwnedByCurrentUser(resource.data.party_id)
          )
        );
      allow create: if request.auth != null
        && (
          isAdmin()
          || ('dj_id' in request.resource.data && request.resource.data.dj_id == request.auth.uid)
          || (
            'party_id' in request.resource.data
            && request.resource.data.party_id is string
            && isPartyOwnedByCurrentUser(request.resource.data.party_id)
          )
        );
    }

    match /shazam_history/{docId} {
      allow read, delete: if request.auth != null
        && (
          isAdmin()
          || ('user_id' in resource.data && resource.data.user_id == request.auth.uid)
          || (
            'party_id' in resource.data
            && resource.data.party_id is string
            && isPartyOwnedByCurrentUser(resource.data.party_id)
          )
        );
      allow create, update: if request.auth != null
        && (
          isAdmin()
          || ('user_id' in request.resource.data && request.resource.data.user_id == request.auth.uid)
        );
    }

    match /admin_stats/{docId} {
      allow read, write: if isAdmin();
    }

    match /{collection}/{docId} {
      allow read: if isCollectionWhitelisted(collection)
        && collection != 'users'
        && collection != 'parties'
        && collection != 'party_status'
        && collection != 'locations'
        && collection != 'wishes'
        && collection != 'music_history'
        && collection != 'countries'
        && collection != 'social_media_links'
        && collection != 'blocked_devices'
        && collection != 'blocked_guests'
        && collection != 'block_history'
        && collection != 'admin_config'
        && collection != 'todos'
        && collection != 'contact_messages'
        && collection != 'contacts'
        && collection != 'last_actions'
        && collection != 'party_sessions'
        && collection != 'shazam_history'
        && collection != 'admin_stats'
        && collection != 'roles'
        && (request.auth != null || isUnauthPublicCollection(collection));
      allow delete: if isCollectionWhitelisted(collection)
        && collection != 'users'
        && collection != 'parties'
        && collection != 'party_status'
        && collection != 'locations'
        && collection != 'wishes'
        && collection != 'music_history'
        && collection != 'countries'
        && collection != 'social_media_links'
        && collection != 'blocked_devices'
        && collection != 'blocked_guests'
        && collection != 'block_history'
        && collection != 'admin_config'
        && collection != 'todos'
        && collection != 'contact_messages'
        && collection != 'contacts'
        && collection != 'last_actions'
        && collection != 'party_sessions'
        && collection != 'shazam_history'
        && collection != 'admin_stats'
        && collection != 'roles'
        && (isAdmin() || isTopLevelDocOwner());
      allow create: if isCollectionWhitelisted(collection)
        && collection != 'users'
        && collection != 'parties'
        && collection != 'party_status'
        && collection != 'locations'
        && collection != 'wishes'
        && collection != 'music_history'
        && collection != 'countries'
        && collection != 'social_media_links'
        && collection != 'blocked_devices'
        && collection != 'blocked_guests'
        && collection != 'block_history'
        && collection != 'admin_config'
        && collection != 'todos'
        && collection != 'contact_messages'
        && collection != 'contacts'
        && collection != 'last_actions'
        && collection != 'party_sessions'
        && collection != 'shazam_history'
        && collection != 'admin_stats'
        && collection != 'roles'
        && canCreateCollectionDoc(collection, request.resource.data)
        && isSafeCollectionData(collection, request.resource.data)
        && (
          isAdmin()
          || isResourceOwnerByCommonFields(request.resource.data)
        );
      allow update: if isCollectionWhitelisted(collection)
        && collection != 'users'
        && collection != 'parties'
        && collection != 'party_status'
        && collection != 'locations'
        && collection != 'wishes'
        && collection != 'music_history'
        && collection != 'countries'
        && collection != 'social_media_links'
        && collection != 'blocked_devices'
        && collection != 'blocked_guests'
        && collection != 'block_history'
        && collection != 'admin_config'
        && collection != 'todos'
        && collection != 'contact_messages'
        && collection != 'contacts'
        && collection != 'last_actions'
        && collection != 'party_sessions'
        && collection != 'shazam_history'
        && collection != 'admin_stats'
        && collection != 'roles'
        && request.auth != null
        && (isAdmin() || isTopLevelDocOwner())
        && isSafeCollectionData(collection, request.resource.data);

      match /{subDocument=**} {
        allow read: if isCollectionWhitelisted(collection)
          && collection != 'users'
          && collection != 'parties'
          && collection != 'wishes'
          && collection != 'music_history'
          && collection != 'countries'
          && collection != 'social_media_links'
          && collection != 'blocked_devices'
          && collection != 'blocked_guests'
          && collection != 'block_history'
          && collection != 'admin_config'
          && (request.auth != null || isUnauthPublicCollection(collection));
        allow delete: if isCollectionWhitelisted(collection)
          && collection != 'users'
          && collection != 'parties'
          && collection != 'wishes'
          && collection != 'music_history'
          && collection != 'countries'
          && collection != 'social_media_links'
          && collection != 'blocked_devices'
          && collection != 'blocked_guests'
          && collection != 'block_history'
          && collection != 'admin_config'
          && (isAdmin() || isTopLevelDocOwner() || isParentDocOwner(collection, docId));
        allow create, update: if isCollectionWhitelisted(collection)
          && collection != 'users'
          && collection != 'parties'
          && collection != 'wishes'
          && collection != 'music_history'
          && collection != 'countries'
          && collection != 'social_media_links'
          && collection != 'blocked_devices'
          && collection != 'blocked_guests'
          && collection != 'block_history'
          && collection != 'admin_config'
          && request.auth != null
          && (
            isAdmin()
            || isParentDocOwner(collection, docId)
            || isResourceOwnerByCommonFields(request.resource.data)
          )
          && isSafeCommonData(request.resource.data);
      }
    }

    match /dj_browser_codes/{codeId} {
      allow read, write: if false;
    }

    match /dj_browser_redeem_rate/{docId} {
      allow read, write: if false;
    }

    match /dj_browser_sessions/{sessionId} {
      allow read: if request.auth != null
        && request.auth.token.role == 'dj_browser'
        && request.auth.token.sessionId == sessionId;
      allow write: if false;
    }

    match /song_suggestions/{trackId} {
      allow read: if isAdmin() || isActiveRbTool();
      allow create, update: if isActiveRbTool()
        && isSafeSongSuggestions(request.resource.data);
      allow delete: if isAdmin();
    }

    match /song_transitions/{trackId} {
      allow read: if isAdmin() || isActiveRbTool();
      allow create, update: if isActiveRbTool()
        && isSafeSongTransitions(request.resource.data);
      allow delete: if isAdmin();
    }

    match /rb_tool_codes/{codeId} {
      allow read, write: if false;
    }
    match /rb_tool_redeem_rate/{docId} {
      allow read, write: if false;
    }
    match /rb_tool_state/{ownerUid} {
      allow read, write: if false;
    }
    match /rb_tool_sessions/{sessionId} {
      allow read: if request.auth != null
        && request.auth.token.role == 'rb_tool'
        && request.auth.token.sessionId == sessionId;
      allow write: if false;
    }
    // Vom Tool gemeldet, Schreiben nur über die Function. Admin liest die Liste.
    match /rb_tool_installs/{installId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /rb_tool_preview/{ownerUid} {
      allow read: if request.auth != null
        && request.auth.token.role == 'rb_tool'
        && request.auth.token.ownerUid == ownerUid;
      allow write: if false;
    }

    match /rb_tool_live/{ownerUid} {
      allow read: if request.auth != null
        && (
          (isAdmin() && request.auth.uid == ownerUid)
          || (
            request.auth.token.role == 'rb_tool'
            && request.auth.token.ownerUid == ownerUid
          )
        );
      allow create, update: if request.auth != null
        && request.auth.token.role == 'rb_tool'
        && request.auth.token.ownerUid == ownerUid
        && request.resource.data.sessionId == request.auth.token.sessionId
        && exists(/databases/$(database)/documents/rb_tool_sessions/$(request.auth.token.sessionId))
        && get(/databases/$(database)/documents/rb_tool_sessions/$(request.auth.token.sessionId)).data.active == true
        && isSafeRbToolLive(request.resource.data);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
