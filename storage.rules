rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwnLogoFile(fileName) {
      return fileName == request.auth.uid + '.jpg'
        || fileName == request.auth.uid + '.jpeg'
        || fileName == request.auth.uid + '.png';
    }

    function isOwnProfileFile(fileName) {
      return fileName == request.auth.uid + '.jpg'
        || fileName == request.auth.uid + '.jpeg'
        || fileName == request.auth.uid + '.png';
    }

    // Client: dj_logos/{uid}.jpg|png — Callable: dj_logos/{uid}/logo.{ext}
    match /dj_logos/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource != null
        && request.resource.size < 3 * 1024 * 1024
        && isOwnLogoFile(fileName);
      allow delete: if request.auth != null && isOwnLogoFile(fileName);
    }

    match /dj_logos/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource != null
        && request.resource.size < 3 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /profile_images/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource != null
        && request.resource.size < 3 * 1024 * 1024
        && isOwnProfileFile(fileName);
      allow delete: if request.auth != null && isOwnProfileFile(fileName);
    }

    match /profile_images/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource != null
        && request.resource.size < 3 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
