rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profilbilder - User können nur ihre eigenen Bilder hochladen/löschen
    match /profile_images/{fileName} {
      allow read: if true; // Alle können Profilbilder lesen
      allow write: if request.auth != null && 
                     (resource == null || fileName.matches(request.auth.uid + '.*'));
      allow delete: if request.auth != null && fileName.matches(request.auth.uid + '.*');
    }
    
    // DJ-Logos - User können nur ihre eigenen Logos hochladen/löschen
    match /dj_logos/{fileName} {
      allow read: if true; // Alle können DJ-Logos lesen
      // Erlaube Upload/Update nur wenn User eingeloggt ist und Dateiname mit UID beginnt
      allow write: if request.auth != null && 
                     (resource == null || fileName.matches(request.auth.uid + '.*'));
      // Erlaube Löschen nur wenn User eingeloggt ist und Dateiname mit UID beginnt
      allow delete: if request.auth != null && fileName.matches(request.auth.uid + '.*');
    }
  }
}

