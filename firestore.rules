    /** Vorab-Einstellungen: aktivieren (nur >6 h vor Start), nie deaktivieren; Limit nur >6 h. */
    function partyPreWishSettingsPatchAllowed(partyId) {
      return request.auth != null
        && partyDocExists(partyId)
        && (isAdmin() || isPartyOwnedByCurrentUser(partyId))
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
